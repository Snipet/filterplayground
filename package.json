{
	"name": "filterplayground",
	"version": "0.1.0",
	"private": true,
	"description": "Interactive analog and digital filter design playground and reference",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.10.0",
		"katex": "^0.19.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=20"
	}
}
